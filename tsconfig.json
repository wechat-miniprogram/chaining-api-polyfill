{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "module": "es2015",
        "target": "es6",
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "lib": ["ES6", "ES7", "DOM", "ESNext"]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ]
}
